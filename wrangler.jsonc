{
  // TimeBox on Cloudflare Workers: `npm run build` outputs the SPA to ./dist, served as static
  // assets. worker/index.ts handles /api/* (usage events and feedback) and stores them in D1.
  "name": "timebox",
  "compatibility_date": "2026-06-04",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served straight from static assets without invoking the Worker.
    "run_worker_first": ["/api/*"]
  },
  // No database_id: wrangler (>= 4.45) creates the database on the first deploy and keeps it
  // linked afterwards. The Worker creates its tables on first use.
  "d1_databases": [{ "binding": "DB", "database_name": "timebox" }]
}
